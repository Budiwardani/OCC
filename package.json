{
  "name": "occ",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "migrate": "node backend/migrate-all.js"
  },
  "devDependencies": {
    "wrangler": "^4.126.0"
  }
}
